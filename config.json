{
  "_說明": "這個檔案是唯一需要依你的模型修改的地方。改完重新啟動 onedrive_worker.py 即可。",
  "mock_mode": false,
  "_mock_mode說明": "true = 不開 FlexSim，用假資料測網頁；false = 真的開 FlexSim 跑模擬",
  "flexsim": {
    "exe": "",
    "model_path": "D:/FlexSim_D1.fsm",
    "max_run_seconds": 1800,
    "max_pause_minutes": 60
  },
  "_flexsim說明": "exe 留空會自動在 C:/Program Files 找 flexsim.exe；找不到時填完整路徑，例如 C:/Program Files/FlexSim 2025 Update 2/program/flexsim.exe。max_run_seconds：單次模擬最多跑幾秒，超過就強制結束。 max_pause_minutes：網頁按「暫停」後最多停幾分鐘，超過就自動停止，避免 FlexSim 一直佔著讓其他人排隊。",
  "onedrive": {
    "share_dir": "%OneDriveCommercial%/FlexSimShare",
    "poll_seconds": 3,
    "heartbeat_seconds": 30
  },
  "_onedrive說明": "預設會自動指到公司 OneDrive 裡的 FlexSimShare 資料夾，通常不用改。",
  "title": "Production Simulator",
  "title_zh": "生產模擬器",
  "subtitle": "Choose a period, then run the FlexSim model.",
  "subtitle_zh": "選擇模擬期間，然後執行 FlexSim 模型。",
  "run_length": null,
  "stop": {
    "type": "end_of_date",
    "set_model_start": true,
    "start_time_of_day": "00:00",
    "model_start": "2026-05-18 12:00",
    "time_unit_seconds": 1,
    "year_param": "year",
    "start_month_param": "st_m",
    "start_day_param": "st_d",
    "end_month_param": "ed_m",
    "end_day_param": "ed_d"
  },
  "_stop說明": "set_model_start=true：每次都把 FlexSim 的模型開始時間改成使用者選的開始日（start_time_of_day 那個時刻），從開始日直接跑到結束日當天 24:00，不用暖機。改成 false 則改回用固定的 model_start（要和 FlexSim 工具列 Run Time 左邊的日期一致）。time_unit_seconds 是模型時間單位（秒=1、分鐘=60、小時=3600）。",
  "parameters": [
    {
      "name": "year",
      "label": "Year",
      "label_zh": "年份",
      "unit": "",
      "type": "integer",
      "default": 2026,
      "min": 2024,
      "max": 2035,
      "step": 1,
      "help": "Simulation year",
      "help_zh": "模擬年份",
      "set_script": "Table(\"WUS_year\")[1][1] = {value}; Table(\"WUS_year\")[1][2] = {value};"
    },
    {
      "name": "st_m",
      "label": "Start month",
      "label_zh": "開始月",
      "unit": "",
      "type": "integer",
      "default": 11,
      "min": 1,
      "max": 12,
      "step": 1,
      "help": "Month the simulation period starts",
      "help_zh": "模擬期間開始的月份",
      "set_script": "Table(\"WUS_year\")[2][1] = {value}; Table(\"WUS_year\")[2][2] = {value};"
    },
    {
      "name": "st_d",
      "label": "Start day",
      "label_zh": "開始日",
      "unit": "",
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 31,
      "step": 1,
      "help": "Day the simulation period starts",
      "help_zh": "模擬期間開始的日期",
      "set_script": "Table(\"WUS_year\")[3][1] = {value}; Table(\"WUS_year\")[3][2] = {value};"
    },
    {
      "name": "ed_m",
      "label": "End month",
      "label_zh": "結束月",
      "unit": "",
      "type": "integer",
      "default": 12,
      "min": 1,
      "max": 12,
      "step": 1,
      "help": "Month the simulation period ends",
      "help_zh": "模擬期間結束的月份",
      "set_script": "Table(\"WUS_year\")[4][1] = {value}; Table(\"WUS_year\")[4][2] = {value};"
    },
    {
      "name": "ed_d",
      "label": "End day",
      "label_zh": "結束日",
      "unit": "",
      "type": "integer",
      "default": 31,
      "min": 1,
      "max": 31,
      "step": 1,
      "help": "Day the simulation period ends",
      "help_zh": "模擬期間結束的日期",
      "set_script": "Table(\"WUS_year\")[5][1] = {value}; Table(\"WUS_year\")[5][2] = {value};"
    }
