{
  "_說明": "這個檔案是唯一需要依你的模型修改的地方。改完重新啟動 onedrive_worker.py 即可。",
  "mock_mode": false,
  "_mock_mode說明": "true = 不開 FlexSim，用假資料測網頁；false = 真的開 FlexSim 跑模擬",
  "flexsim": {
    "exe": "",
    "model_path": "D:/FlexSim_D1.fsm",
    "max_run_seconds": 1800
  },
  "_flexsim說明": "exe 留空會自動在 C:/Program Files 找 flexsim.exe；找不到時填完整路徑，例如 C:/Program Files/FlexSim 2025 Update 2/program/flexsim.exe。max_run_seconds：單次模擬最多跑幾秒，超過就強制結束。",
  "onedrive": {
    "share_dir": "%OneDriveCommercial%/FlexSimShare",
    "poll_seconds": 3,
    "heartbeat_seconds": 30
  },
  "_onedrive說明": "預設會自動指到公司 OneDrive 裡的 FlexSimShare 資料夾，通常不用改。",
  "title": "Production Simulator",
  "subtitle": "Choose a period, then run the FlexSim model.",
  "run_length": null,
  "stop": {
    "type": "end_of_date",
    "model_start": "2026-05-18 12:00",
    "time_unit_seconds": 1,
    "year_param": "year",
    "start_month_param": "st_m",
    "start_day_param": "st_d",
    "end_month_param": "ed_m",
    "end_day_param": "ed_d"
  },
  "_stop說明": "模擬跑到「結束日當天 24:00」為止。model_start 要和 FlexSim 工具列 Run Time 左邊的開始日期時間一致；time_unit_seconds 是模型時間單位（秒=1、分鐘=60、小時=3600）。",
  "parameters": [
    {
      "name": "year",
      "label": "Year",
      "unit": "",
      "type": "integer",
      "default": 2026,
      "min": 2024,
      "max": 2035,
      "step": 1,
      "help": "Simulation year",
      "set_script": "Table(\"WUS_year\")[1][1] = {value};"
    },
    {
      "name": "st_m",
      "label": "Start month",
      "unit": "",
      "type": "integer",
      "default": 11,
      "min": 1,
      "max": 12,
      "step": 1,
      "help": "Month the simulation period starts",
      "set_script": "Table(\"WUS_year\")[2][1] = {value};"
    },
    {
      "name": "st_d",
      "label": "Start day",
      "unit": "",
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 31,
      "step": 1,
      "help": "Day the simulation period starts",
      "set_script": "Table(\"WUS_year\")[3][1] = {value};"
    },
    {
      "name": "ed_m",
      "label": "End month",
      "unit": "",
      "type": "integer",
      "default": 12,
      "min": 1,
      "max": 12,
      "step": 1,
      "help": "Month the simulation period ends",
      "set_script": "Table(\"WUS_year\")[4][1] = {value};"
    },
    {
      "name": "ed_d",
      "label": "End day",
      "unit": "",
      "type": "integer",
      "default": 31,
      "min": 1,
      "max": 31,
      "step": 1,
      "help": "Day the simulation period ends",
      "set_script": "Table(\"WUS_year\")[5][1] = {value};"
    }
  ],
  "_parameters說明": "set_script 是寫入模型的 FlexScript：Table(\"WUS_year\")[列][欄]，第 1 欄是第一個產品。要同時寫第 2 欄就在後面加上 Table(\"WUS_year\")[列][2] = {value};",
  "date_inputs": {
    "year": "year",
    "start_month": "st_m",
    "start_day": "st_d",
    "end_month": "ed_m",
    "end_day": "ed_d"
  },
  "_date_inputs說明": "網頁用兩個日期選擇器（開始日、結束日）取代這 5 個數字欄位，送出時自動拆成年、月、日。不需要的話整段刪掉，網頁就會改回一般數字欄位。",
  "metrics": [
    {
      "name": "total_day",
      "label": "Total days",
      "unit": "days",
      "decimals": 0,
      "script": "Table(\"WUS_year\")[9][1]"
    },
    {
      "name": "total_work_day",
      "label": "Total work days",
      "unit": "days",
      "decimals": 0,
      "script": "Table(\"WUS_year\")[10][1]"
    }
  ],
  "_metrics說明": "每個指標是一段回傳數字的 FlexScript，跑完模擬後讀取。請先在 FlexSim 的 Script Console 測試，例如輸入 return Table(\"WUS_year\")[9][1]; 看結果對不對。"
}